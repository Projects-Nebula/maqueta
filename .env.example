DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL is the canonical local database; run-local.sh starts the compose
# service automatically before applying migrations.
DATABASE_URL=postgres://editor:editor@localhost:5432/editor
# SQLite is supported only as an explicit isolated-test/fallback override:
# DATABASE_URL=sqlite:///db.sqlite3

# AI assistant
# AI_PROVIDER accepts: fake|openai|opencode_zen
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=fake
AI_REQUEST_TIMEOUT=30
AI_MAX_OPERATIONS=20
AI_MAX_INPUT_CHARACTERS=30000
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=minimax-m3
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/go/v1

CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Anonymous analytics (opt-in; purge with manage.py purge_analytics)
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_COOKIE_MAX_AGE=31536000

# Local mockup (./mockup.sh) — destructive development reset.
# These values override the printed demo credentials when uncommented.
# MOCKUP_USERNAME=demo
# MOCKUP_EMAIL=demo@example.com
# MOCKUP_PASSWORD=demo12345
# Never enable this in a shared environment; it bypasses the DEBUG=False guard:
# MOCKUP_ALLOW_NON_DEBUG=1
