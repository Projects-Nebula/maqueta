DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# For local Postgres via `docker compose up db` (see compose.yaml):
# DATABASE_URL=postgres://editor:editor@localhost:5432/editor

# AI assistant
# AI_PROVIDER accepts: fake|openai|opencode_zen
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=fake
AI_REQUEST_TIMEOUT=30
AI_MAX_OPERATIONS=20
AI_MAX_INPUT_CHARACTERS=30000
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=minimax-m3
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/go/v1

CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Storefront / payments
# PAYMENT_PROVIDER accepts: fake|stripe (defaults to stripe once a secret key is set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=usd
